{
  "info": {
    "name": "Assignment 3 Portfolio API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5050" },
    { "key": "userToken", "value": "" },
    { "key": "adminToken", "value": "" }
  ],
  "item": [
    {
      "name": "Sign up regular user",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Sign up returns 201 and role user', function () {",
          "  pm.response.to.have.status(201);",
          "  const body = pm.response.json();",
          "  pm.expect(body.user.role).to.eql('user');",
          "  pm.collectionVariables.set('userToken', body.token);",
          "});"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Regular Student\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/signup"
      }
    },
    {
      "name": "Sign in wrong password",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Wrong password returns 401', function () {",
          "  pm.response.to.have.status(401);",
          "});"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"wrong-password\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/signin"
      }
    },
    {
      "name": "Sign in regular user",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Regular sign in returns 200', function () {",
          "  pm.response.to.have.status(200);",
          "  const body = pm.response.json();",
          "  pm.expect(body.user.role).to.eql('user');",
          "  pm.collectionVariables.set('userToken', body.token);",
          "});"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/signin"
      }
    },
    {
      "name": "GET projects without token",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Projects are public', function () {",
          "  pm.response.to.have.status(200);",
          "  pm.expect(pm.response.json()).to.be.an('array');",
          "});"
        ] }
      }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/projects" }
    },
    {
      "name": "POST project without token",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Create project without a token is 401', function () {",
          "  pm.response.to.have.status(401);",
          "});"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Unauthorized\",\n  \"completion\": \"2026-11-11\",\n  \"description\": \"should be rejected\"\n}"
        },
        "url": "{{baseUrl}}/api/projects"
      }
    },
    {
      "name": "POST project as regular user",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Regular user cannot create a project', function () {",
          "  pm.response.to.have.status(403);",
          "});"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{userToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Forbidden\",\n  \"completion\": \"2026-11-11\",\n  \"description\": \"should be rejected\"\n}"
        },
        "url": "{{baseUrl}}/api/projects"
      }
    },
    {
      "name": "Sign in administrator",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Administrator sign in returns 200', function () {",
          "  pm.response.to.have.status(200);",
          "  const body = pm.response.json();",
          "  pm.expect(body.user.role).to.eql('admin');",
          "  pm.collectionVariables.set('adminToken', body.token);",
          "});"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/signin"
      }
    },
    {
      "name": "POST project as administrator",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Administrator can create a project', function () {",
          "  pm.response.to.have.status(201);",
          "  const body = pm.response.json();",
          "  pm.collectionVariables.set('projectId', body.project._id);",
          "});"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman evidence project\",\n  \"completion\": \"2026-11-11\",\n  \"description\": \"Created from the Postman collection.\",\n  \"role\": \"Developer\",\n  \"technologies\": [\"React\", \"Express\", \"MongoDB\"]\n}"
        },
        "url": "{{baseUrl}}/api/projects"
      }
    },
    {
      "name": "GET contacts without token",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Contacts require a token', function () { pm.response.to.have.status(401); });"
        ] }
      }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/contacts" }
    },
    {
      "name": "GET contacts as regular user",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Regular user cannot read contacts', function () { pm.response.to.have.status(403); });"
        ] }
      }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
        "url": "{{baseUrl}}/api/contacts"
      }
    },
    {
      "name": "POST contact from public form",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Public contact form returns 201', function () { pm.response.to.have.status(201); });"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Marie\",\n  \"lastName\": \"Tremblay\",\n  \"email\": \"marie.postman@example.com\",\n  \"phone\": \"3435550142\",\n  \"message\": \"Saved through the Postman collection.\"\n}"
        },
        "url": "{{baseUrl}}/api/contacts"
      }
    },
    {
      "name": "DELETE evidence project",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Administrator can delete the evidence project', function () { pm.response.to.have.status(200); });"
        ] }
      }],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/api/projects/{{projectId}}"
      }
    }
  ]
}
