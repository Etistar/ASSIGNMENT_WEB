table HR_Analytics
	lineageTag: 89af698c-7b0a-4b08-a4a4-264da222186b

	measure Nombre_Employés = DISTINCTCOUNT(HR_Analytics[EmployeeNumber])
		formatString: 0
		lineageTag: a1b2c3d4-0001-0001-0001-000000000001

		annotation SummarizationSetBy = Automatic

	measure Nb_Départs = CALCULATE(DISTINCTCOUNT(HR_Analytics[EmployeeNumber]), HR_Analytics[Attrition] = "Yes")
		formatString: 0
		lineageTag: a1b2c3d4-0002-0002-0002-000000000002

		annotation SummarizationSetBy = Automatic

	measure Taux_Rotation_Pct = DIVIDE([Nb_Départs], [Nombre_Employés], 0)
		formatString: 0.00%
		lineageTag: a1b2c3d4-0003-0003-0003-000000000003

		annotation SummarizationSetBy = Automatic

	measure Nb_Heures_Supplémentaires = CALCULATE(DISTINCTCOUNT(HR_Analytics[EmployeeNumber]), HR_Analytics[OverTime] = "Yes")
		formatString: 0
		lineageTag: a1b2c3d4-0004-0004-0004-000000000004

		annotation SummarizationSetBy = Automatic

	measure Taux_Absentéisme_Pct = DIVIDE([Nb_Heures_Supplémentaires], [Nombre_Employés], 0)
		formatString: 0.00%
		lineageTag: a1b2c3d4-0005-0005-0005-000000000005

		annotation SummarizationSetBy = Automatic

	measure Ancienneté_Moyenne_Années = AVERAGE(HR_Analytics[YearsAtCompany])
		formatString: #.## "ans"
		lineageTag: a1b2c3d4-0006-0006-0006-000000000006

		annotation SummarizationSetBy = Automatic

	measure Expérience_Moyenne_Années = AVERAGE(HR_Analytics[TotalWorkingYears])
		formatString: #.## "ans"
		lineageTag: a1b2c3d4-0007-0007-0007-000000000007

		annotation SummarizationSetBy = Automatic

	measure Distance_Moyenne_Domicile = AVERAGE(HR_Analytics[DistanceFromHome])
		formatString: 0.0 "km"
		lineageTag: a1b2c3d4-0008-0008-0008-000000000008

		annotation SummarizationSetBy = Automatic

	measure Satisfaction_Environnement_Moy = AVERAGE(HR_Analytics[EnvironmentSatisfaction])
		formatString: 0.00
		lineageTag: a1b2c3d4-0009-0009-0009-000000000009

		annotation SummarizationSetBy = Automatic

	measure Satisfaction_Travail_Moy = AVERAGE(HR_Analytics[JobSatisfaction])
		formatString: 0.00
		lineageTag: a1b2c3d4-0010-0010-0010-000000000010

		annotation SummarizationSetBy = Automatic

	measure Satisfaction_Relations_Moy = AVERAGE(HR_Analytics[RelationshipSatisfaction])
		formatString: 0.00
		lineageTag: a1b2c3d4-0011-0011-0011-000000000011

		annotation SummarizationSetBy = Automatic

	measure Équilibre_Vie_Travail_Moy = AVERAGE(HR_Analytics[WorkLifeBalance])
		formatString: 0.00
		lineageTag: a1b2c3d4-0012-0012-0012-000000000012

		annotation SummarizationSetBy = Automatic

	measure Implication_Travail_Moy = AVERAGE(HR_Analytics[JobInvolvement])
		formatString: 0.00
		lineageTag: a1b2c3d4-0013-0013-0013-000000000013

		annotation SummarizationSetBy = Automatic

	measure Performance_Moyenne = AVERAGE(HR_Analytics[PerformanceRating])
		formatString: 0.00
		lineageTag: a1b2c3d4-0014-0014-0014-000000000014

		annotation SummarizationSetBy = Automatic

	measure Score_Satisfaction_Global = (AVERAGE(HR_Analytics[EnvironmentSatisfaction]) + AVERAGE(HR_Analytics[JobSatisfaction]) + AVERAGE(HR_Analytics[RelationshipSatisfaction]) + AVERAGE(HR_Analytics[WorkLifeBalance])) / 4
		formatString: 0.00
		lineageTag: a1b2c3d4-0015-0015-0015-000000000015

		annotation SummarizationSetBy = Automatic

	measure Salaire_Moyen_Mensuel = AVERAGE(HR_Analytics[MonthlyIncome])
		formatString: #,##0 "$"
		lineageTag: a1b2c3d4-0016-0016-0016-000000000016

		annotation SummarizationSetBy = Automatic

	measure Masse_Salariale_Mensuelle = SUM(HR_Analytics[MonthlyIncome])
		formatString: #,##0 "$"
		lineageTag: a1b2c3d4-0017-0017-0017-000000000017

		annotation SummarizationSetBy = Automatic

	measure Salaire_Moyen_Par_Département = AVERAGEX(HR_Analytics, HR_Analytics[MonthlyIncome])
		formatString: #,##0 "$"
		lineageTag: a1b2c3d4-0018-0018-0018-000000000018

		annotation SummarizationSetBy = Automatic

	measure Ancienneté_Poste_Actuel_Moy = AVERAGE(HR_Analytics[YearsInCurrentRole])
		formatString: #.## "ans"
		lineageTag: a1b2c3d4-0019-0019-0019-000000000019

		annotation SummarizationSetBy = Automatic

	measure Ancienneté_Manager_Actuel_Moy = AVERAGE(HR_Analytics[YearsWithCurrManager])
		formatString: #.## "ans"
		lineageTag: a1b2c3d4-0020-0020-0020-000000000020

		annotation SummarizationSetBy = Automatic

	measure Taux_Promotion_Pct = DIVIDE(CALCULATE(COUNT(HR_Analytics[EmployeeNumber]), HR_Analytics[YearsSinceLastPromotion] = 0), [Nombre_Employés], 0)
		formatString: 0.00%
		lineageTag: a1b2c3d4-0021-0021-0021-000000000021

		annotation SummarizationSetBy = Automatic

	measure Nb_Promotions_Cette_Année = CALCULATE(COUNT(HR_Analytics[EmployeeNumber]), HR_Analytics[YearsSinceLastPromotion] = 0)
		formatString: 0
		lineageTag: a1b2c3d4-0022-0022-0022-000000000022

		annotation SummarizationSetBy = Automatic

